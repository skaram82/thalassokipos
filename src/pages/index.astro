---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Features2 from "../components/Features2.astro";
import Gallery from "../components/Gallery.astro";
import B2B from "../components/B2B.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={SITE.title}
  description="A minimal, modern starter template for building fast websites with Astro. Includes React, Tailwind CSS, Framer Motion, and more."
  canonicalURL={SITE.url}
>
  <Header />
  <main id="main-content" role="main">
    <Hero />
    <Features />
    <div class="bg-slate-950">
      <Features2 />
    </div>
    <Gallery />
    <B2B />
    <CTA />
  </main>
  <Footer />
</Layout>
