---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import fish1 from "@/assets/IMG_0672.jpg";
import fish2 from "@/assets/IMG_0690.jpg";
import fish3 from "@/assets/IMG_8601.jpg";
---

<section id="products" class="max-w-6xl mx-auto px-4 py-20 scroll-mt-24">
  <ScrollReveal client:idle delay={0.1}>
    <h2 class="text-4xl font-bold text-white text-center mb-6">
      Προϊόντα & επιλεγμένες κατηγορίες
    </h2>
    <p class="text-slate-400 text-center mb-12">
      Φρέσκα ψάρια και θαλασσινά με έμφαση στην ποιότητα, την ποικιλία και την
      εικόνα της καθημερινής βιτρίνας του Θαλασσόκηπου.
    </p>
  </ScrollReveal>
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <div
        class="min-h-42 p-6 rounded-lg bg-slate-900 border border-[#0065A3] hover:shadow-lg transition-shadow"
      >
        <h3 class="text-xl font-semibold text-gray-50 mb-2">
          Φρέσκα ψάρια ημέρας
        </h3>
        <p class="text-slate-400">
          Επιλεγμένα προϊόντα καθημερινά, για το σπίτι, τη σχάρα, τον φούρνο και
          την επαγγελματική κουζίνα.
        </p>
      </div>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <div
        class="min-h-42 p-6 rounded-lg bg-slate-900 border border-[#0065A3] hover:shadow-lg transition-shadow"
      >
        <h3 class="text-xl font-semibold text-gray-50 mb-2">Θαλασσινά</h3>
        <p class="text-slate-400">
          Καραβίδες, γαρίδες, οστρακοειδή και ιδιαίτερες επιλογές για
          απαιτητικούς πελάτες και επαγγελματίες.
        </p>
      </div>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <div
        class="min-h-42 p-6 rounded-lg bg-slate-900 border border-[#0065A3] hover:shadow-lg transition-shadow"
      >
        <h3 class="text-xl font-semibold text-gray-50 mb-2">Premium κοπές</h3>
        <p class="text-slate-400">
          Εξειδικευμένες κοπές και προϊόντα υψηλής προστιθέμενης αξίας για όσους
          αναζητούν κάτι διαφορετικό.
        </p>
      </div>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <div
        class="min-h-42 p-6 rounded-lg bg-slate-900 border border-[#0065A3] hover:shadow-lg transition-shadow"
      >
        <h3 class="text-xl font-semibold text-gray-50 mb-2">
          Καθαρισμός & φιλετάρισμα
        </h3>
        <p class="text-slate-400">
          Εξυπηρέτηση με ακρίβεια και φροντίδα, σύμφωνα με τις ανάγκες κάθε
          πελάτη.
        </p>
      </div>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <div
        class="min-h-42 p-6 rounded-lg bg-slate-900 border border-[#0065A3] hover:shadow-lg transition-shadow"
      >
        <h3 class="text-xl font-semibold text-gray-50 mb-2">
          Λιανική και χονδρική
        </h3>
        <p class="text-slate-400">
          Εξυπηρέτηση ιδιωτών, εστιατορίων, ξενοδοχείων, catering και
          επαγγελματιών εστίασης.
        </p>
      </div>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <div
        class="min-h-42 p-6 rounded-lg bg-slate-900 border border-[#0065A3] hover:shadow-lg transition-shadow"
      >
        <h3 class="text-xl font-semibold text-gray-50 mb-2">
          Νέα εποχή για το brand
        </h3>
        <p class="text-slate-400">
          Σύντομα σε νέο σύγχρονο κατάστημα στην Κομνηνών 28, με ακόμη καλύτερη
          εμπειρία αγοράς.
        </p>
      </div>
    </ScrollReveal>
  </div>
</section>
