---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import heroVideo from "../assets/hero_vid.mp4";
---

<section
  class="relative isolate min-h-[85vh] -mt-24 md:min-h-screen overflow-hidden flex items-center"
  aria-labelledby="hero-heading"
>
  <video
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source src={heroVideo} type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-black/50" aria-hidden="true"></div>

  <div class="relative z-10 w-full">
    <div class="max-w-6xl mx-auto px-4 py-24 md:py-32 text-center">
      <ScrollReveal client:load>
        <h1
          id="hero-heading"
          class="text-4xl md:text-6xl font-bold text-white mb-6"
        >
          Θαλασσόκηπος
        </h1>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.2}>
        <p class="text-lg md:text-2xl text-white/90 mb-10 max-w-3xl mx-auto">
          Φρέσκα ψάρια και θαλασσινά, premium κοπές, επιλεγμένες παρασκευές και
          εξυπηρέτηση λιανικής και χονδρικής, με τη σιγουριά μιας οικογενειακής
          παράδοσης δεκαετιών. Σύντομα σας υποδεχόμαστε σε νέο, πιο σύγχρονο
          κατάστημα.
        </p>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.4}>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#products"
            class="inline-flex items-center gap-2 px-8 py-3 bg-white text-gray-900 rounded-lg hover:bg-gray-100 transition-colors font-medium"
            aria-label="View products"
          >
            <span class="mx-auto">Δείτε τα προϊόντα μας</span>
          </a>
          <a
            href="#cta"
            class="inline-block px-8 py-3 bg-transparent text-white border border-white/70 rounded-lg hover:bg-white/10 transition-colors font-medium"
          >
            Επικοινωνήστε μαζί μας
          </a>
        </div>
      </ScrollReveal>
    </div>
  </div>
</section>
