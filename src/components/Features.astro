---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import fish1 from "@/assets/IMG_0672.jpg";
import fish2 from "@/assets/IMG_0690.jpg";
import fish3 from "@/assets/IMG_8601.jpg";
---

<section id="features" class="max-w-6xl mx-auto px-4 py-20">
  <!-- <ScrollReveal client:idle delay={0.1}>
    <h2 class="text-4xl font-bold text-gray-900 text-center mb-12">Features</h2>
  </ScrollReveal> -->
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <div class="relative sm:max-w-sm overflow-hidden rounded-lg">
        <Image
          src={fish1}
          alt="Fish background"
          class="w-full h-72 object-cover"
        />
        <div
          class="absolute inset-0 bg-black/55 p-6 flex flex-col justify-end gap-3"
        >
          <h2 class="text-3xl font-bold text-white">Οικογενειακή παράδοση</h2>
          <p class="text-white/95">
            εμπειρία δεκαετιών στην αγορά ψαριών και θαλασσινών
          </p>
        </div>
      </div>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <div class="relative sm:max-w-sm overflow-hidden rounded-lg">
        <Image
          src={fish2}
          alt="Fish background"
          class="w-full h-72 object-cover"
        />
        <div
          class="absolute inset-0 bg-black/55 p-6 flex flex-col justify-end gap-3"
        >
          <h2 class="text-3xl font-bold text-white">Premium επιλογές</h2>
          <p class="text-white/95">
            dry aged (coming soon), premium κοπές και επιλεγμένες παρασκευές
          </p>
        </div>
      </div>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <div class="relative sm:max-w-sm overflow-hidden rounded-lg">
        <Image
          src={fish3}
          alt="Fish background"
          class="w-full h-72 object-cover"
        />
        <div
          class="absolute inset-0 bg-black/55 p-6 flex flex-col justify-end gap-3"
        >
          <h2 class="text-3xl font-bold text-white">Νέο κατάστημα</h2>
          <p class="text-white/95">
            σύντομα στην οδό Κομνηνών 28, στο κέντρο της Θεσσαλονίκης
          </p>
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>
