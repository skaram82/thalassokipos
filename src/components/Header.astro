---
import { Icon } from "astro-icon/components";
---

<header
  id="site-header"
  class="relative z-50 w-full py-4 px-4 top-0"
  role="banner"
>
  <nav
    class="max-w-6xl mx-auto flex items-center justify-between"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="inline-flex items-center gap-3 text-2xl font-bold text-white hover:text-gray-200 transition-colors"
      aria-label="Θαλασσόκηπος"
    >
      <img
        src="/thalassokipos_logo_white.png"
        alt="Θαλασσόκηπος logo"
        class="w-8 h-8 object-contain"
      />
      Θαλασσόκηπος
    </a>

    <!-- Mobile menu button -->
    <button
      type="button"
      class="md:hidden p-2 text-white hover:text-gray-200 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 rounded-lg"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="mobile-menu-button"
    >
      <Icon name="tabler:menu-2" class="w-6 h-6" aria-hidden="true" />
    </button>

    <!-- Desktop navigation -->
    <ul class="hidden md:flex items-center gap-6" role="list">
      <li>
        <a
          href="#products"
          class="text-white hover:text-gray-200 transition-colors"
          aria-current={Astro.url.pathname === "#products" ? "page" : undefined}
        >
          Προϊόντα
        </a>
      </li>
      <li>
        <a
          href="#b2b"
          class="text-white hover:text-gray-200 transition-colors"
          aria-current={Astro.url.pathname === "#b2b" ? "page" : undefined}
        >
          B2B
        </a>
      </li>
      <li>
        <a
          href="#about"
          class="text-white hover:text-gray-200 transition-colors"
          aria-current={Astro.url.pathname === "#about" ? "page" : undefined}
        >
          Σχετικά με εμάς
        </a>
      </li>
      <li>
        <a
          href="#cta"
          class="px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors"
          aria-current={Astro.url.pathname === "#cta" ? "page" : undefined}
        >
          Επικοινωνία
        </a>
      </li>
    </ul>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-slate-800 bg-slate-950 text-white"
    role="menu"
    aria-labelledby="mobile-menu-button"
  >
    <ul class="flex flex-col py-4" role="list">
      <li>
        <a
          href="#products"
          class="block px-4 py-3 text-white hover:bg-slate-900 transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === "#products" ? "page" : undefined}
        >
          Προϊόντα
        </a>
      </li>
      <li>
        <a
          href="#b2b"
          class="block px-4 py-3 text-white hover:bg-slate-900 transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === "#b2b" ? "page" : undefined}
        >
          B2B
        </a>
      </li>
      <li>
        <a
          href="#about"
          class="block px-4 py-3 text-white hover:bg-slate-900 transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === "#about" ? "page" : undefined}
        >
          Σχετικά με εμάς
        </a>
      </li>
      <li>
        <a
          href="#cta"
          class="block px-4 py-3 text-white hover:bg-slate-900 transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === "#cta" ? "page" : undefined}
        >
          Επικοινωνία
        </a>
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  // Mobile menu toggle functionality
  const menuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const siteHeader = document.getElementById("site-header");

  if (menuButton && mobileMenu && siteHeader) {
    menuButton.addEventListener("click", () => {
      const isExpanded = menuButton.getAttribute("aria-expanded") === "true";

      const willBeExpanded = !isExpanded;
      menuButton.setAttribute("aria-expanded", String(willBeExpanded));
      mobileMenu.classList.toggle("hidden");
      siteHeader.classList.toggle("bg-slate-950", willBeExpanded);
    });

    // Close menu when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target;
      if (
        target instanceof Node &&
        !menuButton.contains(target) &&
        !mobileMenu.contains(target) &&
        !mobileMenu.classList.contains("hidden")
      ) {
        menuButton.setAttribute("aria-expanded", "false");
        mobileMenu.classList.add("hidden");
        siteHeader.classList.remove("bg-slate-950");
      }
    });

    // Close menu on escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !mobileMenu.classList.contains("hidden")) {
        menuButton.setAttribute("aria-expanded", "false");
        mobileMenu.classList.add("hidden");
        siteHeader.classList.remove("bg-slate-950");
        menuButton.focus();
      }
    });
  }
</script>
